/* USB Over Network Client - Resource Script */
#include <windows.h>
#include "resource.h"

/* Version Information */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CTK Technologies"
            VALUE "FileDescription", "USB Over Network Client"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "usb-client-gui"
            VALUE "LegalCopyright", "MIT License (c) 2025 CTK Technologies"
            VALUE "OriginalFilename", "usb-client-gui.exe"
            VALUE "ProductName", "USB Over Network"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

/* Application Manifest: visual styles, DPI awareness, requireAdministrator. */
1 RT_MANIFEST "app.manifest"

