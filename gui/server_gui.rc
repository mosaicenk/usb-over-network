/* USB Over Network Server - Resource Script */

#include <windows.h>
#include "resource.h"

/* Application Icon */
IDI_APP_ICON ICON "app.ico"
IDI_TRAY_ICON ICON "app.ico"

/* Version Information */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "USB Over Network"
            VALUE "FileDescription", "USB Over Network Server"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "usb-server-gui"
            VALUE "LegalCopyright", "Educational Use"
            VALUE "OriginalFilename", "usb-server-gui.exe"
            VALUE "ProductName", "USB Over Network"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

/* Application Manifest for Visual Styles */
1 RT_MANIFEST "app.manifest"
